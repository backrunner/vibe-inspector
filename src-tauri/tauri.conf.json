{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeInspector",
  "version": "0.1.0",
  "identifier": "com.vibeinspector.desktop",
  "build": {
    "beforeDevCommand": "pnpm run prepare:tray:dev && pnpm dev",
    "devUrl": "http://localhost:4173",
    "beforeBuildCommand": "pnpm run prepare:tray:release && pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VibeInspector",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 14, "y": 20 },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"],
    "externalBin": ["binaries/vibe-inspector-tray", "binaries/vibe-inspector-mcp"]
  }
}
