  },
  "devDependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.27.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "shadcn-svelte": "^1.4.2",
